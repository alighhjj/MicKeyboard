<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF1F2430"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ime_idle_hint"
            android:textColor="#FF8A8F99"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/btn_switch_ime"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/ime_switch"
            android:padding="3dp"
            android:src="@drawable/ic_keyboard" />
    </LinearLayout>

    <!-- 按钮排：左=语音输入(开始/停止并发送)，中=发送(回车)，右=退格删除 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_voice"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ime_voice_button"
            android:text="@string/ime_start"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ime_secondary_button"
            android:contentDescription="@string/ime_send"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_send" />

        <ImageButton
            android:id="@+id/btn_backspace"
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ime_secondary_button"
            android:contentDescription="@string/ime_backspace"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_backspace" />
    </LinearLayout>
</LinearLayout>
